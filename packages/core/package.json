{
  "name": "@overweave/core",
  "version": "0.5.0",
  "description": "Layered definitions: contributors with priorities and rights, every field knowing who set it. No dependencies.",
  "keywords": [
    "overweave",
    "registry",
    "layered",
    "definitions",
    "plugins",
    "extensibility",
    "provenance"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overweave/overweave.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/overweave/overweave/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/overweave/overweave/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "overweave-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "MODEL.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  }
}
