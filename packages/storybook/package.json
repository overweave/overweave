{
  "name": "@overweave/storybook",
  "version": "0.3.1",
  "description": "Storybook for what is built on overweave: its config (Preact, one Preact, the workspace's sources), a world drawn in a story (kinds, addons run by the testkit's contract, a slot, what failed), and the Overweave panel (who says what, addons off and on, renders)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overweave/overweave.git",
    "directory": "packages/storybook"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/overweave/overweave/tree/main/packages/storybook#readme",
  "bugs": {
    "url": "https://github.com/overweave/overweave/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "overweave-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manager": {
      "overweave-source": "./src/manager.ts",
      "types": "./dist/manager.d.ts",
      "default": "./dist/manager.js"
    },
    "./preact": {
      "overweave-source": "./src/preact/index.ts",
      "types": "./dist/preact/index.d.ts",
      "default": "./dist/preact/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/testChannel.ts",
    "!src/storybook.d.ts"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@overweave/core": "^0.3.1",
    "@overweave/testkit": "^0.3.1",
    "@overweave/ui": "^0.3.1",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.2",
    "@storybook/preact-vite": "^10.6.0",
    "preact": "^10.29.8",
    "react": ">=18",
    "storybook": "^10.6.0",
    "vite": "^8.3.4"
  },
  "peerDependenciesMeta": {
    "@preact/preset-vite": {
      "optional": true
    },
    "@storybook/preact-vite": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "storybook": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@overweave/core": "0.3.1",
    "@overweave/testkit": "0.3.1",
    "@overweave/ui": "0.3.1",
    "@preact/preset-vite": "2.10.6",
    "@preact/signals": "2.11.3",
    "@testing-library/preact": "3.2.4",
    "happy-dom": "20.14.5",
    "preact": "10.29.8"
  }
}
