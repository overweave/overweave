{
  "name": "@overweave/ui",
  "version": "0.3.0",
  "description": "UI concepts over @overweave/core — slots, fills, wraps, order, the user's arrangement — with no framework; @overweave/ui/preact draws them with Preact",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overweave/overweave.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/overweave/overweave/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/overweave/overweave/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "overweave-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preact": {
      "overweave-source": "./src/preact/index.ts",
      "types": "./dist/preact/index.d.ts",
      "default": "./dist/preact/index.js"
    },
    "./overlay": {
      "overweave-source": "./src/overlay/index.ts",
      "types": "./dist/overlay/index.d.ts",
      "default": "./dist/overlay/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@overweave/core": "^0.3.0",
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "peerDependenciesMeta": {
    "@preact/signals": {
      "optional": true
    },
    "preact": {
      "optional": true
    }
  },
  "devDependencies": {
    "@overweave/core": "0.3.0",
    "@overweave/testkit": "0.3.0",
    "@preact/signals": "2.11.2",
    "@testing-library/preact": "3.2.4",
    "happy-dom": "20.14.5",
    "preact": "10.29.8"
  }
}
